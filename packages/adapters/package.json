{
  "name": "@dossiercle/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/postgres/control.repository.d.ts",
      "import": "./dist/postgres/control.repository.js"
    },
    "./identity/*": {
      "types": "./dist/identity/*.d.ts",
      "import": "./dist/identity/*.js"
    },
    "./postgres/*": {
      "types": "./dist/postgres/*.d.ts",
      "import": "./dist/postgres/*.js"
    },
    "./journal/*": {
      "types": "./dist/journal/*.d.ts",
      "import": "./dist/journal/*.js"
    },
    "./audit/*": {
      "types": "./dist/audit/*.d.ts",
      "import": "./dist/audit/*.js"
    },
    "./outbox/*": {
      "types": "./dist/outbox/*.d.ts",
      "import": "./dist/outbox/*.js"
    },
    "./secrets/*": {
      "types": "./dist/secrets/*.d.ts",
      "import": "./dist/secrets/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "openid-client": "6.8.8",
    "jose": "6.2.12",
    "inngest": "4.23.0",
    "@dossiercle/contracts": "workspace:*",
    "@dossiercle/domain": "workspace:*"
  }
}
